{
  "expo": {
    "name": "SportLog",
    "slug": "sportlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sportlog",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sportlog.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.sportlog.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "your-sentry-org",
          "project": "sportlog"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
