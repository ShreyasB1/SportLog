# ---------------------------------------------------------------------------
# CLIENT-SAFE — prefix EXPO_PUBLIC_ so Metro bundles these into the app
# ---------------------------------------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxx
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ---------------------------------------------------------------------------
# BUILD-TIME ONLY — source map upload; never bundle these
# ---------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=xxx
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=sportlog

# ---------------------------------------------------------------------------
# SERVER-SIDE SECRETS — set via `supabase secrets set`, NEVER prefix EXPO_PUBLIC_
# Run only inside Edge Functions, never in the mobile bundle.
# ---------------------------------------------------------------------------
# CLERK_SECRET_KEY=sk_test_xxx
# SUPABASE_SERVICE_ROLE_KEY=xxx          (provided automatically by Supabase)
# SPORTS_API_KEY=xxx
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# PINECONE_API_KEY=xxx
